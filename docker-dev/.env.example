# ---------------------------------------------------------------------------
# Docker development environment configuration.
#
# Copy this file to `.env` (in THIS docker-dev/ folder) before running
# `docker compose`. These values configure the containers only.
#
# NOTE: This is NOT the Laravel .env. Laravel has its own .env inside
# ./src. In that file you must set:  DB_HOST=db
# (so the app reaches the MySQL container by its service name).
# ---------------------------------------------------------------------------

# Host port the app is exposed on -> http://localhost:8080
APP_PORT=8080

# Host port for phpMyAdmin -> http://localhost:8081
PMA_PORT=8081

# Host port MySQL is published on (connect a local client to localhost:3306)
DB_PORT=3306

# MySQL credentials. These must match ./src/.env (except DB_HOST which is `db`).
DB_DATABASE=triangle_pos
DB_USERNAME=triangle
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# User/group IDs the php-fpm container runs as. Set these to your host user's
# ids (run `id -u` and `id -g`) so files created in ./src are owned by you.
UID=1000
GID=1000

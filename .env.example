APP_NAME="RizqEngine"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

DEBUGBAR_ENABLED=false

# Optional: full path to the wkhtmltopdf / wkhtmltoimage binaries used for PDF
# generation (barcode printing, invoices, etc.). Leave blank to let the app
# auto-detect a binary from common install locations and the system PATH.
# On Windows point this at the .exe, e.g.
# WKHTML_PDF_BINARY="C:\Program Files\wkhtmltopdf\bin\wkhtmltopdf.exe"
WKHTML_PDF_BINARY=
WKHTML_IMG_BINARY=

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rizqengine
DB_USERNAME=
DB_PASSWORD=

# Queue processing. Use "sync" for a single-process demo; switch to
# "database" or "redis" in production and run `php artisan queue:work` so that
# emails and PDF generation do not block web requests.
QUEUE_CONNECTION=sync

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Bot protection (spatie/laravel-honeypot) on public forms -------------
HONEYPOT_ENABLED=true
# Minimum seconds a form must be open before it may be submitted.
HONEYPOT_SECONDS=1

# --- Backups (spatie/laravel-backup) — see README "Backups" ---------------
# Comma-separated filesystem disks; "backups" = storage/app/backups (private).
# Add an off-site disk (e.g. "backups,s3") for disaster recovery.
BACKUP_DISKS=backups
# Enable only after `php artisan backup:run` has succeeded on this server.
BACKUP_SCHEDULE_ENABLED=false
BACKUP_SCHEDULE_TIME=02:00
BACKUP_CLEANUP_TIME=01:30
BACKUP_MONITOR_TIME=06:00
# Failure e-mails are sent only when this is set.
BACKUP_NOTIFICATION_EMAIL=
# Optional: encrypt backup archives (keep this secret somewhere safe!).
BACKUP_ARCHIVE_PASSWORD=
BACKUP_MAX_AGE_DAYS=1
BACKUP_MAX_STORAGE_MB=5000
BACKUP_KEEP_ALL_DAYS=7
BACKUP_KEEP_DAILY_DAYS=16
BACKUP_KEEP_WEEKLY_WEEKS=8
BACKUP_KEEP_MONTHLY_MONTHS=4
BACKUP_KEEP_YEARLY_YEARS=2

# --- Health monitoring (spatie/laravel-health) ---------------------------
# Failure e-mails are sent only when this is set.
HEALTH_TO_ADDRESS=
HEALTH_DISK_WARN_PERCENTAGE=70
HEALTH_DISK_FAIL_PERCENTAGE=90
# Enable once cron runs `schedule:run` every minute.
HEALTH_CHECK_SCHEDULE=false
# Queue / backup checks default to on when a real queue / scheduled backups are configured.
#HEALTH_CHECK_QUEUE=
#HEALTH_CHECK_BACKUPS=

# --- Documents: PDF and spreadsheet import / export ------------------------
DOCUMENTS_PDF_PAPER=a4
DOCUMENTS_PDF_ORIENTATION=portrait
IMPORT_MAX_KB=5120
IMPORT_MAX_ROWS=5000
EXPORT_DATE_FORMAT=Y-m-d

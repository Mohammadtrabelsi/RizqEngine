APP_NAME="RizqEngine"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

DEBUGBAR_ENABLED=false

# Optional: full path to the wkhtmltopdf / wkhtmltoimage binaries used for PDF
# generation (barcode printing, invoices, etc.). Leave blank to let the app
# auto-detect a binary from common install locations and the system PATH.
# On Windows point this at the .exe, e.g.
# WKHTML_PDF_BINARY="C:\Program Files\wkhtmltopdf\bin\wkhtmltopdf.exe"
WKHTML_PDF_BINARY=
WKHTML_IMG_BINARY=

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rizqengine
DB_USERNAME=
DB_PASSWORD=

# Queue processing. Use "sync" for a single-process demo; switch to
# "database" or "redis" in production and run `php artisan queue:work` so that
# emails and PDF generation do not block web requests.
QUEUE_CONNECTION=sync

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "anayarojo/shoppingcart",
                "version": "4.2.4",
                "source": {
                    "type": "git",
                    "url": "https://github.com/anayarojo/laravel-shopping-cart.git",
                    "reference": "776023ad546b7b54a680f783b84cc55bc3fa1a77"
                },
                "dist": {
                    "type": "zip",
                    "url": "https://api.github.com/repos/anayarojo/laravel-shopping-cart/zipball/776023ad546b7b54a680f783b84cc55bc3fa1a77",
                    "reference": "776023ad546b7b54a680f783b84cc55bc3fa1a77"
                },
                "require": {
                    "illuminate/events": "^11.0||^12.0||^13.0",
                    "illuminate/session": "^11.0||^12.0||^13.0",
                    "illuminate/support": "^11.0||^12.0||^13.0",
                    "nesbot/carbon": "^2.0||^3.0"
                },
                "autoload": {
                    "psr-4": {
                        "Gloudemans\\Shoppingcart\\": "src/"
                    }
                },
                "extra": {
                    "laravel": {
                        "providers": [
                            "Gloudemans\\Shoppingcart\\ShoppingcartServiceProvider"
                        ],
                        "aliases": {
                            "Cart": "Gloudemans\\Shoppingcart\\Facades\\Cart"
                        }
                    }
                }
            }
        }
    ],
    "require": {
        "php": "^8.2",
        "anayarojo/shoppingcart": "4.2.4",
        "barryvdh/laravel-dompdf": "^3.0",
        "barryvdh/laravel-snappy": "^1.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "h4cc/wkhtmltopdf-amd64": "^0.12.4",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6",
        "livewire/livewire": "^4.0",
        "milon/barcode": "^13.0",
        "realrashid/sweet-alert": "^7.0",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-permission": "^8.0",
        "spatie/laravel-translatable": "^6.0",
        "yajra/laravel-datatables": "^13.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "fakerphp/faker": "^1.9.1",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.30",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
